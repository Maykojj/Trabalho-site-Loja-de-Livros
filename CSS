/* Configurações Globais */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background-color: #fffdec;
  color: #333;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

/* Header Principal */
.top-header {
  background-color: #d49527;
  color: white;
  padding: 12px 0;
}

.top-header .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo-area {
  font-weight: bold;
  font-size: 1.3rem;
}

.search-bar {
  flex-grow: 0.4;
}

.search-bar input {
  width: 100%;
  padding: 8px 15px;
  border-radius: 20px;
  border: 1px solid #b37a1a;
  outline: none;
}

.header-icons {
  display: flex;
  gap: 20px;
}

/* Menu de Navegação */
.nav-bar {
  background-color: #e69e2c;
  padding: 10px 0;
}

.nav-bar ul {
  display: flex;
  justify-content: space-around;
  list-style: none;
}

.nav-bar a {
  color: white;
  text-decoration: none;
  font-weight: bold;
  font-size: 0.9rem;
}

/* Banner Centralizado */
.banner-container {
  margin: 25px 0;
}

.banner {
  background-color: #f7dca3;
  border-radius: 6px;
  padding: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
}

.banner-img {
  width: 95px;
  height: 130px;
  background-color: #2b7bb9;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 8px;
  font-size: 0.75rem;
  font-weight: bold;
  border-radius: 4px;
}

.banner-text h3 {
  font-size: 1.1rem;
  margin-bottom: 8px;
}

.price-de {
  color: #b02626;
  font-weight: bold;
  margin-bottom: 4px;
}

.price-por {
  color: #24a148;
  font-weight: bold;
}

/* Grade de Produtos */
.section-title {
  font-size: 1.1rem;
  font-weight: bold;
  margin: 35px 0 15px 0;
  color: #444;
}

.grid-produtos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.card-produto {
  display: flex;
  flex-direction: column;
}

/* Caixas Bege de Fundo */
.capa-container {
  background-color: #ecdcb9;
  height: 190px;
  border-radius: 20px 20px 0 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
}

/* O Livro de Exemplo */
.livro-real {
  width: 105px;
  height: 145px;
  background-color: #16375c;
  color: white;
  padding: 12px;
  font-size: 0.85rem;
  font-weight: bold;
  border-radius: 4px;
  box-shadow: 2px 4px 8px rgba(0,0,0,0.15);
  position: absolute;
  bottom: 20px;
}

/* Barra Verde Interativa */
.action-bar {
  background-color: #7bf069;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 12px;
  border-radius: 0 0 12px 12px;
}

.btn-comprar {
  background: none;
  border: none;
  color: white;
  font-weight: bold;
  font-size: 0.85rem;
  cursor: pointer;
}

.contador {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 4px;
  padding: 2px 6px;
  gap: 8px;
  font-size: 0.85rem;
}

.contador button {
  background: none;
  border: none;
  font-weight: bold;
  cursor: pointer;
  padding: 0 4px;
}

/* Textos Abaixo do Card */
.produto-info {
  padding: 10px 5px;
  font-size: 0.85rem;
}

.nome-livro {
  font-weight: bold;
  margin-bottom: 6px;
}

.preco-de {
  color: #888;
}

.preco-por {
  color: #c92222;
  font-weight: bold;
}

/* Rodapé */
.main-footer {
  background-color: #e69e2c;
  margin-top: 60px;
  padding: 30px 0 20px 0;
  font-size: 0.85rem;
}

.footer-links {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255,255,255,0.25);
  padding-bottom: 20px;
  margin-bottom: 20px;
}

.footer-col h4 {
  margin-bottom: 10px;
  color: #2c1e0a;
}

.footer-col ul {
  list-style: none;
}

.footer-col li {
  margin-bottom: 6px;
  color: #444;
}

.footer-bottom {
  text-align: center;
  color: #555;
  font-size: 0.8rem;
}
